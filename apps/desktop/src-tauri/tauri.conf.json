{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARIA Image Studio",
  "version": "1.0.0",
  "identifier": "com.aria.imagestudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ARIA Image Studio",
        "width": 1480,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ARIA",
    "copyright": "Copyright (c) 2026 ARIA",
    "category": "GraphicsAndDesign",
    "shortDescription": "Codex-powered AI image studio",
    "longDescription": "ARIA Image Studio creates, edits, enhances and manages images using the Codex built-in image generation engine. No OpenAI API key required.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*",
      "resources/licenses/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
